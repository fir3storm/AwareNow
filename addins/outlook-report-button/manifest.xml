<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>7f2c9c1e-3b1a-4a6a-9b7b-1a2b3c4d5e6f</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>AwareNow</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="AwareNow Report Phishing" />
  <Description DefaultValue="Report a suspicious or simulated phishing email to AwareNow for review." />
  <IconUrl DefaultValue="https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST/addins/outlook-report-button/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST/addins/outlook-report-button/icon-80.png" />
  <SupportUrl DefaultValue="https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST/addins/outlook-report-button/" />

  <AppDomains>
    <AppDomain>https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <!--
    This base-schema Requirements block (unprefixed Sets/Set, in the default
    appforoffice/1.1 namespace) declares the minimum requirement set for
    clients that don't understand VersionOverrides at all. The actual
    integrated-spam-reporting requirement (Mailbox 1.14) is declared again,
    correctly, inside <VersionOverrides> below using bt:Sets, which is the
    element that Outlook clients supporting ReportPhishingCommandSurface
    actually read.
  -->
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST/addins/outlook-report-button/src/commands.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!--
    Per Microsoft's current docs (learn.microsoft.com/office/dev/add-ins/outlook/spam-reporting,
    "Add-in only manifest" tab), the ReportPhishingCommandSurface / ReportPhishingCustomization
    structure requires VersionOverridesV1_1, nested inside an outer VersionOverridesV1_0 wrapper
    element. This nesting looks unusual but matches Microsoft's own example exactly.
  -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.14">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <!-- References the HTML file that links to the spam-reporting event handler.
                 Used by Outlook on the web and on Mac, and new Outlook on Windows
                 (browser runtime). -->
            <Runtime resid="WebViewRuntime.Url">
              <!-- References the JavaScript file that contains the spam-reporting event
                   handler directly (no imports). Used by classic Outlook on Windows
                   (JavaScript-only runtime). -->
              <Override type="javascript" resid="JSRuntime.Url" />
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="WebViewRuntime.Url" />
            <!-- Implements the integrated spam-reporting feature: this replaces Outlook's
                 native "Report" button in the ribbon. -->
            <ExtensionPoint xsi:type="ReportPhishingCommandSurface">
              <ReportPhishingCustomization>
                <!-- Ribbon button. -->
                <Control xsi:type="Button" id="AwareNowReportButton">
                  <Label resid="ReportButton.Label" />
                  <Supertip>
                    <Title resid="ReportButton.Label" />
                    <Description resid="ReportButton.SuperTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>onSpamReport</FunctionName>
                  </Action>
                </Control>
                <!-- Preprocessing dialog: kept simple for v1 (just confirm/cancel) — no
                     reporting-options checkboxes/radio buttons and no free-text box.
                     NeverShowAgainOption is explicitly set to false: since we have no input
                     options configured, leaving this unset (or true) would let the dialog be
                     silently suppressed after a user's first report. We want every report to
                     get a fresh explicit confirmation, deliberately, not by omission. -->
                <PreProcessingDialog>
                  <Title resid="PreProcessingDialog.Title" />
                  <Description resid="PreProcessingDialog.Description" />
                  <NeverShowAgainOption>false</NeverShowAgainOption>
                </PreProcessingDialog>
                <!-- Must match the resid of the Runtime element representing the browser
                     runtime (the HTML file), not the JS override. -->
                <SourceLocation resid="WebViewRuntime.Url" />
              </ReportPhishingCustomization>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST/addins/outlook-report-button/icon-16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST/addins/outlook-report-button/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST/addins/outlook-report-button/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST/addins/outlook-report-button/src/commands.html" />
          <bt:Url id="JSRuntime.Url" DefaultValue="https://REPLACE_WITH_YOUR_DEPLOYMENT_HOST/addins/outlook-report-button/src/spamreporting.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="ReportButton.Label" DefaultValue="Report to AwareNow" />
          <bt:String id="PreProcessingDialog.Title" DefaultValue="Report to AwareNow" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ReportButton.SuperTip" DefaultValue="Report this message to AwareNow for review." />
          <bt:String id="PreProcessingDialog.Description" DefaultValue="This will send a copy of this message to your security team for review." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
