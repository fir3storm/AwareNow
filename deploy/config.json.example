{
	"admin_server": {
		"listen_url": "127.0.0.1:__ADMIN_PORT__",
		"use_tls": false,
		"cert_path": "gophish_admin.crt",
		"key_path": "gophish_admin.key",
		"trusted_origins": [
			"__ADMIN_HOST__"
		]
	},
	"phish_server": {
		"listen_url": "127.0.0.1:__PHISH_PORT__",
		"use_tls": false,
		"cert_path": "example.crt",
		"key_path": "example.key"
	},
	"db_name": "sqlite3",
	"db_path": "gophish.db",
	"migrations_prefix": "db/db_",
	"contact_address": "",
	"logging": {
		"filename": "",
		"level": ""
	}
}
