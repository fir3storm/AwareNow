[Unit]
Description=Gophish (authorized phishing simulation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gophish
Group=gophish
WorkingDirectory=/opt/gophish/runtime
ExecStart=/opt/gophish/runtime/gophish
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Do not bind public :80/:443 — nginx already owns those on this VPS.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
