# Kept as a copy of the location block. On a live VPS (certbot already ran),
# do not paste this by hand and do not re-run install.sh.
# Use: bash /opt/awarenow/scripts/enable-got-phished.sh

    location = /got-phished {
        default_type text/html;
        alias /opt/awarenow/templates/insec/static/got-phished.html;
    }
