# Public ingress template. The control plane reaches the engine through the
# private tenant network; this listener must never expose engine control APIs.
upstream awarenow_tenant_engine {
    server engine:3333;
}

server {
    listen 443 ssl;
    server_name ${CAMPAIGN_DOMAIN};

    # Deliberately indistinguishable from a missing public route. Do not proxy
    # this location or add an allow-list: control API traffic stays private.
    location ^~ /api/v1/control/ {
        return 404;
    }

    location / {
        proxy_pass http://awarenow_tenant_engine;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
